{
    "interface_version": 2,
    "name": "NIG-Kes",
    "description": "Set the emulator to 16:9 resolution; on PC set the game window to 16:9 and run this app as administrator; for phones refer to the Maa Android setup",
    "contact": "QQ group: 437587416",
    "license": "MIT",
    "welcome": "Veronica reporting for duty!",
    "icon": "./resource/image/logo.png",
    "github": "https://github.com/OGZnZ/Maa_Kes",
    "version": "2.0.0",
    "title": "NIG-Kes v2.0.0",
    "controller": [
        {
            "name": "Android",
            "type": "Adb",
            "display_short_side": 720 // Default short-side length of the scaled resolution
        },
        {
            "name": "Desktop",
            "type": "Win32",
            "description": "Must run as administrator!!! Otherwise the game window cannot be connected",
            "win32": {
                "class_regex": "GLFW30",
                "window_regex": "卡厄思梦境|卡厄思夢境|Chaos Zero Nightmare|カオゼロ",
                "screencap": "PrintWindow", // Screenshot method
                "mouse": "PostMessageWithCursorPos", // Mouse control method
                "keyboard": "PostMessageWithCursorPos" // Keyboard control method
            }
        }
    ],
    "resource": [
        {
            "name": "Simplified Chinese",
            "label": "Simplified Chinese",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "Traditional Chinese",
            "label": "Traditional Chinese",
            "path": [
                "./resource",
                "./resource_TC"
            ]
        }
    ],
    // Optional agent example
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [],
    "group": [
        {
            "name": "Daily",
            "label": "Daily"
        },
        {
            "name": "Standalone Tools",
            "label": "Standalone Tools"
        }
    ],
    "preset": [
        {
            "name": "Preset 1",
            "label": "Preset 1"
        }
    ],
    "import": [
        "tasks/LaunchGame.json",
        // Daily
        "tasks/Daily/CoffeeBreak.json",
        "tasks/Daily/HealingCenter.json",
        "tasks/Daily/ReviewPolicies.json",
        "tasks/Daily/SpendTimeTogether.json",
        "tasks/Daily/Simulation.json",
        "tasks/Daily/Sortie.json",
        "tasks/Daily/ClaimRewards.json",
        // Roguelike
        "tasks/Roguelike/ChaosProgression.json",
        "tasks/Roguelike/ChaosReroll.json",
        // Standalone tools
        "tasks/Tools/AutoProgression.json",
        "tasks/Tools/StorySkip.json",
        "tasks/Tools/ReadMessages.json",
        "tasks/Tools/ClearRedDots.json",
        "tasks/Tools/InteractiveHelper.json",
        "tasks/Tools/AutoBattle.json",
        // Close
        "tasks/CloseGame.json"
    ],
    "option": {
        "WIP": {
            "label": "Unfinished, to be improved",
            "cases": []
        }
    }
}
