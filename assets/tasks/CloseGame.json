{
    "task": [
        {
            "name": "Close Game",
            "label": "🎮Close Game",
            "default_check": true,
            "group": [
                "Daily"
            ],
            "entry": "关游戏-任务开始层",
            "description": "Auto-closing emulator games is currently only supported for the CN and Global servers; if you need another one, please provide the package name\n\nOn PC, close from an administrator run, otherwise the window cannot be connected\n\nResolution must be 16:9",
            "pipeline_override": {
                "关游戏-任务开始层": {
                    "enabled": true
                }
            },
            "option": [
                "模拟器直接关游戏"
            ]
        }
    ],
    "option": {
        "模拟器直接关游戏": {
            "label": "Auto Close via Emulator",
            "type": "switch",
            "controller": [
                "Android"
            ],
            "description": "Emulators close the game via package name; there is currently no way to close the game directly on PC",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "模拟器包名关闭"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "关游戏-任务开始层": {
                            "action": "DoNothing"
                        }
                    }
                }
            ]
        },
        "模拟器包名关闭": {
            "label": "Server Select",
            "type": "select",
            "controller": [
                "Android"
            ],
            "cases": [
                {
                    "name": "国服",
                    "label": "CN Server",
                    "pipeline_override": {
                        "关游戏-任务开始层": {
                            "action": "StopApp",
                            "package": "com.tencent.czn",
                            "next": []
                        }
                    }
                },
                {
                    "name": "国际服",
                    "label": "Global Server",
                    "pipeline_override": {
                        "关游戏-任务开始层": {
                            "action": "StopApp",
                            "package": "com.smilegate.chaoszero.stove.google",
                            "next": []
                        }
                    }
                }
            ]
        }
    }
}