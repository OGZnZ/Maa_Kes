{
    "task": [
        {
            "name": "Launch Game",
            "label": "🎮Launch Game",
            "default_check": true,
            "group": [
                "Daily"
            ],
            "entry": "进游戏-任务开始层",
            "description": "Auto-launching emulator games is currently only supported for the CN and Global servers; if you need another one, please provide the package name\n\nOn PC, launch from an administrator run, otherwise the window cannot be connected\n\nResolution must be 16:9",
            "pipeline_override": {
                "进游戏-点击进入游戏": {
                    "enabled": true
                }
            },
            "option": [
                "模拟器自启动游戏"
            ]
        }
    ],
    "option": {
        "模拟器自启动游戏": {
            "label": "Auto Launch via Emulator",
            "type": "switch",
            "controller": [
                "Android"
            ],
            "description": "Emulators launch the game via package name; there is currently no way to launch the game directly on PC",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "模拟器包名启动"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "进游戏-任务开始层": {
                            "action": "DoNothing"
                        }
                    }
                }
            ]
        },
        "模拟器包名启动": {
            "label": "Server Select",
            "type": "select",
            "controller": [
                "Android"
            ],
            "cases": [
                {
                    "name": "国服",
                    "label": "CN Server",
                    "pipeline_override": {
                        "进游戏-任务开始层": {
                            "action": "StartApp",
                            "package": "com.tencent.czn"
                        }
                    }
                },
                {
                    "name": "国际服",
                    "label": "Global Server",
                    "pipeline_override": {
                        "进游戏-任务开始层": {
                            "action": "StartApp",
                            "package": "com.smilegate.chaoszero.stove.google"
                        }
                    }
                }
            ]
        }
    }
}